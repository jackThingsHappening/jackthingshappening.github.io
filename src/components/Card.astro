---
import dayjs from 'dayjs'
import Carousel from './Carousel.astro'
import SaveToCalendar from './SaveToCalendar.astro'

export interface Props {
  post: any;
  highlighted?: string;
  images?: string[];
}

let { post, highlighted, images } = Astro.props;

// Ensure icon path is root-relative so icons work on nested routes (e.g. /chattanooga/guides/tag/...)
const iconPath = post.iconPath
  ? post.iconPath.startsWith('/') || post.iconPath.startsWith('http')
    ? post.iconPath
    : post.iconPath.includes('images/')
      ? '/' + post.iconPath.replace(/^.*images\//, 'images/')
      : post.iconPath
  : undefined;

const carouselImages = images?.length ? images : post.images?.length ? post.images : [];
const singleImage = carouselImages.length === 1
  ? (typeof carouselImages[0] === 'string'
      ? { src: carouselImages[0], position: 'center' }
      : { src: carouselImages[0].src, position: carouselImages[0].position || 'center' })
  : null;
const positionClasses = {
  top: 'object-top',
  upper: 'object-[50%_25%]',
  center: 'object-center',
  lower: 'object-[50%_75%]',
  bottom: 'object-bottom',
};

const pubDate = post.pubDate || post.lastUpdated
const pubDateLocal = typeof pubDate === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(pubDate) ? pubDate + 'T00:00:00' : pubDate;
const date = new Date(pubDateLocal);
const daysOfWeek = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
const dayOfWeek = daysOfWeek[date.getDay()];

let eventDateDetails;
if (post.eventDatesDetails) {
  const slugFromUrl = post.url?.split('/').pop();

  const slugify = (title) =>
    (title ?? '')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '');

  eventDateDetails = post.eventDatesDetails.find(
    (dateObj) =>
      dateObj.date === post.pubDate &&
      slugify(dateObj.eventTitle) === slugFromUrl
  );
}
const subTitle = eventDateDetails && eventDateDetails.eventTitle ? eventDateDetails.eventTitle : dayjs(pubDateLocal).format('MM-DD-YYYY');
const calendarTitle = post.title + (eventDateDetails?.eventTitle ? `: ${eventDateDetails.eventTitle}` : '');
---

<div class="bg-white border-[1.5px] border-black hover:border-customGreen1 transition-all duration-75 ease-in-out h-full block shadow-lg hover:shadow-2xl rounded-xl overflow-hidden" data-test="article-card" data-event-url={post.url}>
  <!-- Title & Date Section -->
  <div class="flex items-start justify-between pt-6 pb-3 px-4">
    <a href={post.url} class="block flex-1 min-w-0">
      <h2 class="text-[1.8rem] leading-tight" style="">
        {post.title}{eventDateDetails?.eventTitle ? `: ${eventDateDetails.eventTitle}` : ''}
      </h2>
      {(post.pubDate || post.lastUpdated) && (
        <p class="text-lg text-gray-600 mt-2 flex items-center gap-2">
          {`${dayOfWeek}`} {dayjs(pubDateLocal).format('MM-DD-YYYY')}
          {iconPath ? <img class="w-8 h-8 inline-icon" src={iconPath} alt="icon" /> : ""}
        </p>
      )}
      {post.time && (
        <p class="text-lg text-gray-600">{post.time}</p>
      )}
    </a>
    {post.pubDate && (
      <div class="ml-3 mt-1 flex-shrink-0 flex flex-col items-center gap-1 md:flex-row md:gap-2">
        <SaveToCalendar
          title={calendarTitle}
          pubDate={post.pubDate}
          time={post.time}
          venue={post.venue}
          address={post.address}
          description={post.seoDescription}
        />
        <button
          class="favorite-btn flex items-center justify-center w-8 h-8"
          aria-label="Save event"
          type="button"
        >
          <svg class="star-icon w-6 h-6" viewBox="0 0 453 434" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M442.634 197.902C451.905 188.865 455.178 175.602 451.178 163.289C447.177 150.976 436.733 142.171 423.921 140.31L311.891 124.031C309.692 123.712 307.791 122.331 306.807 120.337L256.706 18.822C250.977 7.212 239.375 0 226.428 0C213.481 0 201.879 7.212 196.15 18.822L146.049 120.338C145.064 122.331 143.164 123.712 140.964 124.032L28.9355 140.31C16.1235 142.171 5.6805 150.976 1.6785 163.289C-2.3235 175.602 0.950502 188.865 10.2225 197.902L91.2875 276.921C92.8785 278.473 93.6055 280.708 93.2295 282.899L74.0925 394.475C71.9045 407.236 77.0505 419.889 87.5245 427.499C97.9985 435.111 111.626 436.094 123.084 430.071L223.286 377.392C225.254 376.357 227.603 376.357 229.572 377.392L329.773 430.071C334.757 432.691 340.151 433.986 345.518 433.985C352.488 433.985 359.414 431.801 365.331 427.498C375.805 419.887 380.952 407.233 378.763 394.474L359.626 282.898C359.251 280.707 359.977 278.472 361.568 276.92L442.634 197.902ZM333.005 287.466L352.142 399.044C352.782 402.778 350.477 404.907 349.456 405.648C348.434 406.388 345.696 407.925 342.344 406.161L242.142 353.482C237.223 350.897 231.827 349.603 226.43 349.603C221.033 349.603 215.636 350.897 210.718 353.481L110.517 406.159C107.163 407.922 104.426 406.387 103.405 405.646C102.384 404.905 100.077 402.776 100.718 399.042L119.855 287.466C121.734 276.511 118.105 265.339 110.144 257.58L29.0795 178.561C26.3665 175.915 26.9805 172.838 27.3715 171.638C27.7605 170.437 29.0735 167.586 32.8225 167.042L144.85 150.763C155.849 149.165 165.354 142.261 170.274 132.292L220.375 30.776C222.052 27.379 225.168 27.012 226.431 27.012C227.692 27.012 230.808 27.378 232.486 30.776V30.777L282.587 132.293C287.506 142.262 297.01 149.166 308.009 150.764L420.038 167.043C423.787 167.587 425.098 170.438 425.488 171.639C425.878 172.84 426.494 175.918 423.78 178.562L342.715 257.581C334.755 265.339 331.126 276.511 333.005 287.466Z" fill="currentColor"/>
          </svg>
        </button>
      </div>
    )}
  </div>

  <!-- Images Section: single image when one, carousel when multiple -->
  {singleImage && (
    <div class="w-full overflow-hidden rounded-t-xl py-4 px-4">
      <img
        src={singleImage.src}
        alt=""
        class={`w-full aspect-[3/2] object-cover rounded-lg ${positionClasses[singleImage.position] || positionClasses.center}`}
        loading="eager"
      />
    </div>
  )}
  {carouselImages.length > 1 && <Carousel images={carouselImages} />}

  <!-- Overview Section -->
  {(post.seoDescription || post.topDetails?.text) && (
    <a href={post.url} class="block">
      <p class="px-4 mt-6 mb-1 text-lg text-gray-600 line-clamp-2">{post.seoDescription || post.topDetails?.text}<span class="text-2xl">...</span></p>
    </a>
  )}

  <!-- Full Description Accordion -->
  {(post.seoDescription || post.topDetails?.text) && (
    <details class="group px-4 mt-3">
      <summary class="cursor-pointer list-none flex items-center gap-1 text-lg text-customGreen1 select-none w-fit py-1 hover:underline hover:opacity-80">
        <svg class="w-4 h-4 transition-transform duration-150 group-open:rotate-180 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
        <span class="group-open:hidden">Full description</span>
        <span class="hidden group-open:inline">Less</span>
      </summary>
      <a href={post.url} class="block">
        <p class="mt-2 mb-2 text-xl text-gray-600">{post.seoDescription || post.topDetails?.text}</p>
      </a>
    </details>
  )}

  <!-- More Details Accordion (events only) -->
  {(post.venue || post.entranceCost || post.address || post.eventLink) && (
    <details class="group px-4 pb-3">
      <summary class="cursor-pointer list-none flex items-center gap-1 text-lg text-customGreen1 select-none w-fit py-1 hover:underline hover:opacity-80">
        <svg class="w-4 h-4 transition-transform duration-150 group-open:rotate-180 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
        <span class="group-open:hidden">More details</span>
        <span class="hidden group-open:inline">Less</span>
      </summary>
      <div class="mt-2 space-y-1 text-base text-gray-600 pl-1">
        {post.venue && <p>{post.venue}</p>}
        {post.address && <p>{post.address}</p>}
        {post.entranceCost && <p>Cost: {post.entranceCost}</p>}
        {post.eventLink && (
          <a href={post.eventLink} target="_blank" rel="noopener noreferrer" class="text-customGreen1 underline block">Event info &rarr;</a>
        )}
      </div>
    </details>
  )}

  <!-- Tags Section -->
  <div class="flex items-center px-4 pb-5 pt-1 text-base">
    {post.tags && (
      <div class="flex flex-wrap gap-y-2">
        {Array.isArray(post.tags) ? (
          post.tags.map((t) => {
            const highlight = t == highlighted ? 'font-semibold' : ''
            const tagHref = t.type === 'guide' ? `/chattanooga/guides/tag/${t.tag}` : `/chattanooga/events/tag/${t.tag}`;
            return <a href={tagHref} class={`${highlight} bg-black text-white rounded transition-all duration-75 h-fit inline px-3 py-2 mr-2 whitespace-nowrap`}><span style="color: #3CB371; letter-spacing: 1px">#</span>{t.tag}</a>
          })
        ) : (
          <span>Tags are not an array.</span>
        )}
      </div>
    )}
  </div>
</div>

<style>
  .inline-icon {
    width: 2rem;
    height: 2rem;
    aspect-ratio: 1;
    object-fit: contain;
  }
  .card-saved {
    border-color: #3CB371 !important;
  }
  .favorite-btn .star-icon {
    color: #d1d5db;
    transition: color 0.15s ease;
  }
  .card-saved .favorite-btn .star-icon {
    color: #3CB371;
  }
  .favorite-btn:hover .star-icon {
    color: #9ca3af;
  }
  .card-saved .favorite-btn:hover .star-icon {
    color: #2e9e5e;
  }
</style>

<script>
  const STORAGE_KEY = 'savedEvents';

  function getSaved(): string[] {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
    } catch {
      return [];
    }
  }

  function setSaved(urls: string[]): void {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(urls));
  }

  function updateCard(card: HTMLElement, isSaved: boolean): void {
    if (isSaved) {
      card.classList.add('card-saved');
    } else {
      card.classList.remove('card-saved');
    }
  }

  function initCards(): void {
    const saved = getSaved();
    const cards = document.querySelectorAll<HTMLElement>('[data-event-url]');

    cards.forEach((card) => {
      const url = card.dataset.eventUrl;
      if (!url) return;

      updateCard(card, saved.includes(url));

      const btn = card.querySelector<HTMLButtonElement>('.favorite-btn');
      if (!btn) return;

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const current = getSaved();
        const isNowSaved = current.includes(url);
        if (isNowSaved) {
          setSaved(current.filter((u) => u !== url));
          updateCard(card, false);
        } else {
          setSaved([...current, url]);
          updateCard(card, true);
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCards);
  } else {
    initCards();
  }
</script>