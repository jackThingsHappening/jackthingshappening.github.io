---
export type ActiveTab = 'all' | 'interactive' | 'guides' | 'editorials';

interface Props {
  active: ActiveTab;
}

const { active } = Astro.props;

const linkClass = (tab: ActiveTab) =>
  active === tab
    ? 'text-customGreen1 font-semibold border-b-2 border-black pb-1'
    : 'text-gray-600 hover:text-customGreen1 pb-1 border-b-2 border-transparent hover:border-black transition-colors';
---

<nav class="flex gap-5 pt-10 text-2xl md:text-[1.7rem]" aria-label="Guides and editorials">
  <a href="/chattanooga" class={linkClass('all')}>All</a>
  <a href="/chattanooga/guides/tag/interactive" class={linkClass('interactive')}>Interactive</a>
  <a href="/chattanooga/guides/tag/longform" class={linkClass('guides')}>
    <span class="md:hidden">Longform</span>
    <span class="hidden md:inline">Longform Guides</span>
  </a>

</nav>
