---

---

<script src="https://cdnjs.cloudflare.com/ajax/libs/lunr.js/2.3.9/lunr.min.js" integrity="sha512-4xUl/d6D6THrAnXAwGajXkoWaeMNwEKK4iNfq5DotEbLPAfk6FSxSP3ydNxqDgCw1c/0Z1Jg6L8h2j+++9BZmg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

<section class="max-w-3xl mx-auto px-3">
  <div class="searchBoxContainer">
    <input type="text" id="searchBox" class="searchBox w-full px-2 py-1" placeholder="Search..." data-test="search-input" autocomplete="off" />
  </div>

  <div id="searchResults" class="searchResults lg:pl-8"></div>

  <script>
    let lunrIndex;
    let pagesIndex;

    const buildQuery = (query) =>
      query.trim().split(/\s+/).filter(Boolean).map(term =>
        term.length >= 3 ? `${term}*` : term
      ).join(' ');

    const initLunr = () => {
      const request = new XMLHttpRequest();
      request.open('GET', '/search-index.json', true);
      request.onload = function () {
        if (this.status >= 200 && this.status < 400) {
          pagesIndex = JSON.parse(this.response);
          lunrIndex = lunr(function () {
            this.ref('slug');
            this.field('title', { boost: 10 });
            this.field('description', { boost: 5 });
            this.field('venue', { boost: 3 });
            this.field('body');
            pagesIndex.forEach((page) => this.add(page));
          });
        } else {
          console.error('Failed to load search index');
        }
      };
      request.onerror = () => console.error('Search index connection error');
      request.send();
    };

    const search = (query) => {
      if (!lunrIndex) return [];
      let results = [];
      try {
        results = lunrIndex.search(buildQuery(query));
      } catch {
        try {
          results = lunrIndex.search(query);
        } catch {}
      }
      return results
        .map((r) => pagesIndex.find((p) => p.slug === r.ref))
        .filter(Boolean);
    };

    const renderResults = (results, query) => {
      const searchResults = document.querySelector('#searchResults');
      while (searchResults.firstChild) searchResults.removeChild(searchResults.firstChild);

      if (!results.length) {
        const div = document.createElement('div');
        div.className = 'searchResultPage';
        div.textContent = `No results found for "${query}"`;
        searchResults.append(div);
        return;
      }

      results.slice(0, 10).forEach((result) => {
        const resultPage = document.createElement('div');
        resultPage.className = 'searchResultPage';

        const resultTitle = document.createElement('a');
        resultTitle.className = 'searchResultTitle';
        resultTitle.href = `/${result.slug}`;
        resultTitle.textContent = result.title;
        resultPage.append(resultTitle);

        if (result.description) {
          const resultDesc = document.createElement('div');
          resultDesc.className = 'searchResultBody';
          resultDesc.textContent = result.description;
          resultPage.append(resultDesc);
        }

        if (result.venue) {
          const venueEl = document.createElement('div');
          venueEl.className = 'searchResultVenue text-gray-500 text-sm mt-1';
          venueEl.textContent = result.venue;
          resultPage.append(venueEl);
        }

        searchResults.append(resultPage);
      });
    };

    const initUI = () => {
      const searchBox = document.querySelector('#searchBox');
      if (!searchBox) return;
      searchBox.addEventListener('keyup', (event) => {
        const searchResultsArea = document.querySelector('#searchResults');
        const query = event.currentTarget.value;
        if (query.length < 2) {
          searchResultsArea.style.display = 'none';
          return;
        }
        renderResults(search(query), query);
        searchResultsArea.style.display = 'block';
      });
    };

    initLunr();
    initUI();
  </script>

  <script client:load>
    document.getElementById('searchBox').focus();
  </script>
</section>
