---
import { Image } from 'astro:assets';

type Props = {
  src: string;
  alt: string;
  class?: string;
  className?: string;
  width?: number;
  height?: number;
  [key: string]: any;
};

const { src, alt, class: classAttr, className, width, height, ...rest } = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  [
    '/src/assets/images/**/*.{jpg,jpeg,png,webp}',
    '/src/assets/editorials/**/*.{jpg,jpeg,png,webp}',
  ],
  { eager: true }
);

const key = `/src/assets${src}`;
const imgModule = allImages[key];
const resolvedClass = classAttr ?? className;
---

{imgModule
  ? <Image src={imgModule.default} alt={alt} class={resolvedClass} width={width} height={height} {...rest} />
  : <img src={src} alt={alt} class={resolvedClass} loading="lazy" width={width} height={height} />
}
