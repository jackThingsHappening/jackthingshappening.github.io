<form
  action="https://assets.mailerlite.com/jsonp/930023/forms/120101421906396888/subscribe"
  method="post"
  target="_blank"
  class="flex flex-col sm:flex-row gap-2 mt-2"
>
  <input
    type="text"
    name="fields[name]"
    placeholder="First name"
    autocomplete="given-name"
    class="border-2 border-gray-600 rounded px-4 py-2 text-base w-full sm:w-auto focus:outline-none focus:border-black"
  />
  <input
    type="email"
    name="fields[email]"
    placeholder="Email"
    autocomplete="email"
    required
    class="border-2 border-gray-600 rounded px-4 py-2 text-base w-full sm:w-auto focus:outline-none focus:border-black"
  />
  <input type="hidden" name="ml-submit" value="1" />
  <input type="hidden" name="anticsrf" value="true" />
  <button
    type="submit"
    class="bg-black text-white rounded px-5 py-2 text-base font-semibold hover:bg-gray-800 transition-colors whitespace-nowrap"
  >
    Subscribe
  </button>
</form>

<script>
  fetch("https://assets.mailerlite.com/jsonp/930023/forms/120101421906396888/takel");
</script>
