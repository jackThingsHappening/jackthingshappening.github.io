---
---

<form
  id="ml-signup-form"
  action="https://assets.mailerlite.com/jsonp/930023/forms/120101421906396888/subscribe"
  method="post"
  class="flex flex-col sm:flex-row gap-2 mt-2"
>
  <input
    type="text"
    name="fields[name]"
    placeholder="First name"
    autocomplete="given-name"
    class="border-2 border-gray-600 rounded px-4 py-2 text-base w-full sm:w-auto focus:outline-none focus:border-black"
  />
  <input
    type="email"
    name="fields[email]"
    placeholder="Email"
    autocomplete="email"
    required
    class="border-2 border-gray-600 rounded px-4 py-2 text-base w-full sm:w-auto focus:outline-none focus:border-black"
  />
  <input type="hidden" name="ml-submit" value="1" />
  <input type="hidden" name="anticsrf" value="true" />
  <button
    type="submit"
    class="bg-black text-white rounded px-5 py-2 text-base font-semibold hover:bg-gray-800 transition-colors whitespace-nowrap"
  >
    Subscribe
  </button>
</form>
<p id="ml-signup-msg" class="mt-2 text-base hidden"></p>

<script>
  const form = document.getElementById('ml-signup-form');
  const msg = document.getElementById('ml-signup-msg');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    try {
      const res = await fetch(form.action, { method: 'POST', body: data });
      const json = await res.json();
      if (json.success) {
        form.classList.add('hidden');
        msg.textContent = "You're in. Thanks for subscribing.";
        msg.classList.remove('hidden', 'text-red-600');
        msg.classList.add('text-green-700');
      } else {
        msg.textContent = 'Something went wrong. Please try again.';
        msg.classList.remove('hidden');
        msg.classList.add('text-red-600');
      }
    } catch {
      msg.textContent = 'Something went wrong. Please try again.';
      msg.classList.remove('hidden');
      msg.classList.add('text-red-600');
    }
  });
</script>
