      src={`https://www.youtube.com/embed/${youtube}`} frameborder="0"
      allow="accelerometer; autoplay; encrypted-media; gyroscope;" allowfullscreen></iframe>
  </div>}

  <div>
    {eventDateDetails && eventDateDetails.topDetails && (
      <div>
        {eventDateDetails.topDetails.title && <h2 class="text-2xl font-semibold	pt-12">{eventDateDetails.topDetails.title}</h2>}
        <div style="white-space: pre-wrap;">{eventDateDetails.topDetails.text}</div>
      </div>
    )}
  </div>

  <!-- Content -->
  <section class="max-w-6xl mx-auto content font-body">
    <slot />
  </section>

  <div>
    {eventDateDetails && eventDateDetails.bottomDetails && (
      <div>
        <h2 class="text-2xl font-semibold	">{eventDateDetails.bottomDetails.title}</h2>
        <div>{eventDateDetails.bottomDetails.text}</div>
      </div>
    )}
  </div>

  {venueEvents.length > 0 && (
    <div class="mt-10 pt-6 border-t border-gray-200">
      <p class="text-logoDarkGreen text-base uppercase tracking-widest mb-4">More from {venue ?? venueSlug}</p>
      <div class="flex flex-col gap-3">
        {venueEvents.map((e: any) => (
          <a href={e.url} class="flex flex-col hover:opacity-70 transition-opacity no-underline">
            <span class="text-customGreen1 font-semibold">{e.frontmatter.title}</span>
            {e.frontmatter.pubDate && <span class="text-gray-400 text-sm">{e.frontmatter.pubDate}</span>}
          </a>
        ))}
      </div>
    </div>
  )}

  {similarEvents.length > 0 && (
    <div class="mt-10 pt-6 border-t border-gray-200">
      <p class="text-logoDarkGreen text-base uppercase tracking-widest mb-4">Similar events</p>
      <div class="flex flex-col gap-3">
        {similarEvents.map((e: any) => (
          <a href={e.url} class="flex flex-col hover:opacity-70 transition-opacity no-underline">
            <span class="text-customGreen1 font-semibold">{e.frontmatter.title}</span>
            <span class="text-gray-400 text-sm">{[e.frontmatter.venue, e.frontmatter.pubDate].filter(Boolean).join(' · ')}</span>
          </a>
        ))}
      </div>
    </div>
  )}

  {relatedGuide && pathname?.includes('/events/') && (
    <div class="mt-10 pt-6 border-t border-gray-200">
      <p class="text-logoDarkGreen text-base uppercase tracking-widest mb-2">Explore more</p>
      <a href={`/chattanooga/guides/${relatedGuide.slug}`} class="text-customGreen1 font-semibold text-xl underline decoration-logoDarkGreen underline-offset-8 hover:opacity-70 transition-opacity">
        {relatedGuide.label} →
      </a>
    </div>
  )}

  {!hideSignup && pathname?.includes('/events/') && (
    <div class="mt-12 pt-8 border-t border-gray-200">
      <p class="text-logoDarkGreen-600 text-2xl mb-3">Get our local guides and events updates.</p>
      <EmailSignup />
    </div>
  )}

</article>
