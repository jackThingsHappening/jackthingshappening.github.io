---
import EmailSignup from './EmailSignup.astro'
import dayjs from 'dayjs'
import { venueBySlug } from '../data/venues'

export interface Props {
  // Core post metadata
  title: string;
  pubDate?: string;
  originalDate?: string;
  lastUpdated?: string;
  readTime?: string;
  author?: string;
  description?: string;
  tags?: Array<{ type: string; tag: string }>;

  // Event/venue metadata
  time?: string;
  venue?: string;
  venueDetails?: string;
  address?: string;
  entranceCost?: string;
  eventLink?: string;
  ticketsLink?: string;
  matchedDetails?: any;
  eventDatesDetails?: any;
  eventDates?: string[];

  // Media
  hero?: string;
  youtube?: string;

  // Additional optional metadata
  seoDescription?: string;
  featured?: boolean;
  geoCoverage?: string;
  neighborhoods?: string[];
  seasonality?: string;
  accessibilityNotes?: string;
  parking?: string;
  kidFriendly?: boolean;
  petFriendly?: boolean;
  bestFor?: string[];
  sources?: string[];
  pageItems?: Array<{
    title: string;
    description: string;
    order: number;
    tags: string[];
    photoOptions?: {
      photos: string[];
      appearance?: 'before' | 'after' | 'inline';
    };
  }>;
  /** Override the series/subtitle line above the title. Default: "The Chattanooga Guides Series"; editorials default to "A Things Happening Chattanooga Editorial" when pathname contains /editorials/ */
  seriesLabel?: string;
  /** Used to pick default seriesLabel for editorials vs guides; pass Astro.url.pathname */
  pathname?: string;
}

let { address, author, readTime, matchedDetails, eventDatesDetails, eventDates, eventLink, entranceCost, lastUpdated, originalDate, title, time, pubDate, tags, ticketsLink, venue, venueDetails, hero, youtube,
  // Additional optional metadata
  seoDescription, featured, geoCoverage, neighborhoods, seasonality, accessibilityNotes, parking, kidFriendly, petFriendly, bestFor, sources, pageItems, seriesLabel, pathname, hideSignup } = Astro.props;

const displaySeriesLabel = seriesLabel ?? (pathname?.includes('/editorials/') ? 'A Things Happening Chattanooga Editorial' : pathname?.includes('/events/') ? 'Things Happening In Chattanooga' : 'The Chattanooga Guides Series');
const displayDates = eventDates?.length
  ? eventDates
  : (eventDatesDetails?.map((d: any) => d.date) ?? []);
const date = new Date(pubDate);
let eventDateDetails;
// console.log(matchedDetails)
if (matchedDetails) {
  eventDateDetails = matchedDetails;
} else if (eventDatesDetails) {
  eventDateDetails = eventDatesDetails.find((dateObj => dateObj.date == pubDate));
}


const daysOfWeek = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
const dayOfWeek = daysOfWeek[date.getDay()];
const subTitle = eventDateDetails && eventDateDetails.eventTitle ? eventDateDetails.eventTitle : dayjs(pubDate).format('MM-DD-YYYY');
entranceCost = eventDateDetails && eventDateDetails.entranceCost ?  eventDateDetails.entranceCost : entranceCost
time = eventDateDetails && eventDateDetails.time ?  eventDateDetails.time : time
venue = eventDateDetails && eventDateDetails.venue ?  eventDateDetails.venue : venue
address = eventDateDetails && eventDateDetails.address ?  eventDateDetails.address : address
ticketsLink = eventDateDetails && eventDateDetails.ticketsLink ?  eventDateDetails.ticketsLink : ticketsLink
eventLink = eventDateDetails && eventDateDetails.eventLink ?  eventDateDetails.eventLink : eventLink
const hasMetadata = !!(pubDate || time || venue || address || entranceCost || author || readTime || lastUpdated || originalDate || geoCoverage || (neighborhoods && neighborhoods.length) || seasonality || parking || accessibilityNotes || kidFriendly !== undefined || petFriendly !== undefined || (bestFor && bestFor.length) || eventLink || ticketsLink || (tags && tags.length > 0) || (sources && sources.length) || displayDates.length > 0);

const GUIDE_MAP: Record<string, { slug: string; label: string }> = {
  'music':       { slug: 'live-music',               label: 'Live Music in Chattanooga' },
  'live-events': { slug: 'live-music',               label: 'Live Music in Chattanooga' },
  'comedy':      { slug: 'performance-arts',         label: 'Performing Arts in Chattanooga' },
  'theatre':     { slug: 'performance-arts',         label: 'Performing Arts in Chattanooga' },
  'sports':      { slug: 'live-sports',              label: 'Live Sports in Chattanooga' },
  'outdoors':    { slug: 'outdoors',                 label: 'Outdoor Adventures in Chattanooga' },
  'farm':        { slug: 'outdoors',                 label: 'Outdoor Adventures in Chattanooga' },
  'museum':      { slug: 'exhibits',                 label: 'Exhibits & Museums in Chattanooga' },
  'brewery':     { slug: 'breweries-and-wineries',   label: 'Breweries & Wineries in Chattanooga' },
  'food-drink':  { slug: 'breweries-and-wineries',   label: 'Breweries & Wineries in Chattanooga' },
  'food':        { slug: 'restaurants-with-a-view',  label: 'Restaurants in Chattanooga' },
};

const relatedGuide = tags
  ? tags.map(t => GUIDE_MAP[t.tag]).find(Boolean) ?? null
  : null;

const venueSlug = tags?.find((t: any) => t.type === 'place')?.tag ?? null;
const venuePage = venueSlug && venueBySlug[venueSlug] ? `/chattanooga/venues/${venueSlug}` : null;

const isEventPage = pathname?.includes('/events/');
const allEvents = isEventPage ? await Astro.glob('../pages/chattanooga/events/**/*.mdx') : [];

const currentPlaceTag = tags?.find((t: any) => t.type === 'place')?.tag ?? null;
const currentGenreTags = tags?.filter((t: any) => t.type === 'genre').map((t: any) => t.tag) ?? [];

const today = new Date().toISOString().slice(0, 10);

function getEventDate(fm: any): string {
  if (fm.pubDate) return fm.pubDate;
  if (fm.eventDates?.length) return fm.eventDates[fm.eventDates.length - 1];
  return '';
}

const venueEvents = currentPlaceTag
  ? allEvents
      .filter(e => {
        const eTags: any[] = e.frontmatter.tags ?? [];
        return e.url !== pathname && eTags.some(t => t.type === 'place' && t.tag === currentPlaceTag);
      })
      .sort((a, b) => getEventDate(b.frontmatter) > getEventDate(a.frontmatter) ? 1 : -1)
      .slice(0, 3)
  : [];

const similarEvents = currentGenreTags.length > 0
  ? allEvents
      .filter(e => {
        const eTags: any[] = e.frontmatter.tags ?? [];
        if (e.url === pathname) return false;
        if (currentPlaceTag && eTags.some(t => t.type === 'place' && t.tag === currentPlaceTag)) return false;
        return currentGenreTags.some(g => eTags.some(t => t.type === 'genre' && t.tag === g));
      })
      .sort((a, b) => getEventDate(b.frontmatter) > getEventDate(a.frontmatter) ? 1 : -1)
      .slice(0, 3)
  : [];

function buildCalendarDates(dateStr: string, timeStr?: string): { start: string; end: string; allDay: boolean } {
  const compact = dateStr.replace(/-/g, '');
  const pad = (n: number) => String(n).padStart(2, '0');

  const parseT = (t: string): [number, number] | null => {
    const u = t.trim().toUpperCase().replace(/\s/g, '');
    const pm = u.endsWith('PM');
    const am = u.endsWith('AM');
    const d = u.replace(/[APM]/g, '');
    const [hS, mS = '00'] = d.split(':');
    const h = parseInt(hS), m = parseInt(mS);
    if (isNaN(h)) return null;
    let hour = h;
    if (pm && h !== 12) hour = h + 12;
    if (am && h === 12) hour = 0;
    return [hour, m];
  };

  const nextDay = () => {
    const d = new Date(dateStr + 'T12:00:00');
    d.setDate(d.getDate() + 1);
    return d.toISOString().slice(0, 10).replace(/-/g, '');
  };

  if (!timeStr) return { start: compact, end: nextDay(), allDay: true };

  const parts = timeStr.split(/\s*[-–—]\s*/);
  if (parts.length === 2) {
    let s = parts[0].trim(), e = parts[1].trim();
    if (!/[AaPpMm]/.test(s) && /[AaPpMm]/.test(e)) {
      s += ' ' + (e.toUpperCase().includes('PM') ? 'PM' : 'AM');
    }
    const sp = parseT(s), ep = parseT(e);
    if (sp && ep) return {
      start: `${compact}T${pad(sp[0])}${pad(sp[1])}00`,
      end: `${compact}T${pad(ep[0])}${pad(ep[1])}00`,
      allDay: false,
    };
  }

  const p = parseT(timeStr);
  if (p) return {
    start: `${compact}T${pad(p[0])}${pad(p[1])}00`,
    end: `${compact}T${pad((p[0] + 2) % 24)}${pad(p[1])}00`,
    allDay: false,
  };

  return { start: compact, end: nextDay(), allDay: true };
}

const calDates = pubDate ? buildCalendarDates(pubDate, time ?? undefined) : null;
const calLoc = encodeURIComponent(address ?? venue ?? '');
const calDetails = encodeURIComponent(eventLink ?? '');
const calTitle = encodeURIComponent(title);

const googleCalUrl = calDates
  ? `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${calTitle}&dates=${calDates.start}/${calDates.end}${calLoc ? `&location=${calLoc}` : ''}${calDetails ? `&details=${calDetails}` : ''}`
  : null;

const fmtOutlook = (s: string) => s.length === 8
  ? `${s.slice(0,4)}-${s.slice(4,6)}-${s.slice(6,8)}`
  : `${s.slice(0,4)}-${s.slice(4,6)}-${s.slice(6,8)}T${s.slice(9,11)}:${s.slice(11,13)}:00`;

const outlookCalUrl = calDates
  ? `https://outlook.live.com/calendar/0/deeplink/compose?subject=${calTitle}&startdt=${fmtOutlook(calDates.start)}&enddt=${fmtOutlook(calDates.end)}${calLoc ? `&location=${calLoc}` : ''}${calDetails ? `&body=${calDetails}` : ''}`
  : null;

const icsHref = calDates ? (() => {
  const esc = (s: string) => s.replace(/[,;\\]/g, c => '\\' + c);
  const lines = [
    'BEGIN:VCALENDAR',
    'VERSION:2.0',
    'PRODID:-//ThingsHappening//EN',
    'BEGIN:VEVENT',
    `SUMMARY:${esc(title)}`,
    calDates.allDay ? `DTSTART;VALUE=DATE:${calDates.start}` : `DTSTART:${calDates.start}`,
    calDates.allDay ? `DTEND;VALUE=DATE:${calDates.end}` : `DTEND:${calDates.end}`,
    (address ?? venue) ? `LOCATION:${esc(address ?? venue ?? '')}` : null,
    eventLink ? `URL:${eventLink}` : null,
    eventLink ? `DESCRIPTION:${eventLink}` : null,
    'END:VEVENT',
    'END:VCALENDAR',
  ].filter(Boolean).join('\r\n');
  return `data:text/calendar;charset=utf8,${encodeURIComponent(lines)}`;
})() : null;
---
<div class={`header-styles pt-14 pb-14 lg:flex-wrap md:flex-wrap sm:flex-nowrap text-xl ${!hasMetadata && !displaySeriesLabel ? 'mb-0' : 'mb-10'}`}>
  <header class="max-w-5xl content max-w-5xl mx-auto px-3 text-3xl tracking-wide">
    {displaySeriesLabel ? (
      <h2 class="text-xl font-semibold tracking-widest">
        {displaySeriesLabel}
      </h2>
    ) : null}
    <h1 class="break-words mb-0" style="font-family: 'Libre Baskerville', serif; font-size: clamp(2.75rem, 5vw, 4.5rem);">{title}{eventDateDetails?.eventTitle ? `: ${eventDateDetails.eventTitle}` : ''}</h1>
 </header>
  {hasMetadata && <div class="max-w-5xl content max-w-5xl mx-auto px-3 text-lg">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-1">
      {pubDate ? <div><span class="font-semibold">When:</span> {pubDate} {`(${dayOfWeek})`}</div> : ""}
      {time ? <div><span class="font-semibold">Time:</span> {time}</div> : ""}
      {venue ? <div><span class="font-semibold">Venue:</span> {venuePage ? <a href={venuePage} class="underline hover:text-customGreen1">{venue}</a> : venue}</div> : ""}
      {venueDetails ? <div><span class="font-semibold">Venue Details:</span> {venueDetails}</div> : ""}
      {address ? <div><span class="font-semibold">Address:</span> {address}</div> : ""}
      {entranceCost ? <div><span class="font-semibold">Entrance Fee:</span> {entranceCost}</div> : ""}
      {author ? <div><span class="font-semibold">Original Author:</span> <a href="/about">{author}</a></div> : ""}
      {readTime ? <div><span class="font-semibold">Read time:</span> {readTime}</div> : ""}
      {lastUpdated ? <div><span class="font-semibold">Last updated:</span> {lastUpdated}</div> : ""}
      {originalDate ? <div><span class="font-semibold">Published on:</span> {originalDate}</div> : ""}
      {geoCoverage ? <div><span class="font-semibold">Geo coverage:</span> {geoCoverage}</div> : ""}
      {neighborhoods && neighborhoods.length ? <div><span class="font-semibold">Neighborhoods:</span> {neighborhoods.join(', ')}</div> : ""}
      {seasonality ? <div><span class="font-semibold">Seasonality:</span> {seasonality}</div> : ""}
      {parking ? <div><span class="font-semibold">Parking:</span> {parking}</div> : ""}
      {accessibilityNotes ? <div><span class="font-semibold">Accessibility:</span> {accessibilityNotes}</div> : ""}
      {(kidFriendly !== undefined) ? <div><span class="font-semibold">Kid friendly:</span> {kidFriendly ? 'Yes' : 'No'}</div> : ""}
      {(petFriendly !== undefined) ? <div><span class="font-semibold">Pet friendly:</span> {petFriendly ? 'Yes' : 'No'}</div> : ""}
      {bestFor && bestFor.length ? <div><span class="font-semibold">Best for:</span> {bestFor.join(', ')}</div> : ""}
    </div>
    <div class="mt-2">
      {eventLink ? <a target="_blank" class="mr-3 underline-pink" href={eventLink}>Event Website</a> : ""}
      {() => { 
        if(ticketsLink && ticketsLink.includes("http")) {
          return <a target="_blank" class="mr-1 underline-pink" href={ticketsLink}>Tickets Link</a>
        } else if (ticketsLink) {
        return <div><b>Tickets Link:</b> {ticketsLink}</div>
        } else {
          ""
        }
      }}
    </div>
    {(pathname?.includes('/events/') || pathname?.includes('/guides/')) && (
      <div class="mt-3 flex flex-wrap gap-2">
        {pubDate && googleCalUrl && (
          <>
            <a href={googleCalUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm text-white hover:text-customGreen1 transition-colors border border-gray-300 hover:border-customGreen1 rounded-full px-4 py-2 no-underline">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              Google
            </a>
            <a href={icsHref} download="event.ics" class="inline-flex items-center gap-1.5 text-sm text-white hover:text-customGreen1 transition-colors border border-gray-300 hover:border-customGreen1 rounded-full px-4 py-2 no-underline">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              Apple
            </a>
            <a href={outlookCalUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm text-white hover:text-customGreen1 transition-colors border border-gray-300 hover:border-customGreen1 rounded-full px-4 py-2 no-underline">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              Outlook
            </a>
          </>
        )}
        <div id="add-to-cal-wrap" class="contents"></div>
        <button id="copy-link-btn" class="inline-flex items-center gap-1.5 text-sm text-white hover:text-customGreen1 transition-colors cursor-pointer border border-gray-300 hover:border-customGreen1 rounded-full px-5 py-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          <span id="copy-link-label">Link</span>
        </button>
      </div>
    )}
    {!pubDate && eventDates && eventDates.length > 0 && (
      <div
        id="recurring-cal-data"
        class="hidden"
        data-title={title}
        data-time={time ?? ''}
        data-address={address ?? venue ?? ''}
        data-event-link={eventLink ?? ''}
        data-event-dates={JSON.stringify(eventDates)}
      ></div>
    )}
    <div class="mt-2">
      {tags && tags.length > 0 && (
        <div>
          {tags.map(tag => {
            const tagHref = tag.type === 'guide' ? `/chattanooga/guides/tag/${tag.tag}` : `/tag/${tag.type}/${tag.tag}`;
            return <a class="mr-3 no-underline text-warmGreen" href={tagHref}><span class="text-white">#</span>{tag.tag}</a>
          })}
        </div>
      )}
    </div>
    {sources && sources.length ? (
      <div class="mt-2">
        <div><b>Sources:</b> {sources.join(', ')}</div>
      </div>
    ) : ""}
    {displayDates.length > 0 && (
      <div class="mt-4">
        <span class="font-semibold">Upcoming Dates:</span>
        {eventDatesDetails ? (
          <ul class="mt-2 flex flex-wrap gap-2 list-none p-0 m-0">
            {displayDates.map((d: string) => {
              const detail = eventDatesDetails.find((ed: any) => ed.date === d);
              let href = `?date=${d}`;
              if (detail?.eventTitle && pathname) {
                const slug = detail.eventTitle.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
                const parts = pathname.split('/').filter(Boolean);
                const dateIdx = parts.findIndex((p: string) => /^\d{4}-\d{2}-\d{2}$/.test(p));
                const baseParts = dateIdx !== -1 ? parts.slice(0, dateIdx) : parts;
                const basePath = '/' + baseParts.join('/');
                href = `${basePath}/${d}/${slug}`;
              }
              return (
                <li>
                  <a href={href} data-date={d} class="date-pill">
                    {dayjs(d).format('ddd MMM D')}
                  </a>
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="mt-1 text-gray-300">
            {displayDates.map((d: string, i: number) => (
              <span>{dayjs(d).format('ddd MMM D')}{i < displayDates.length - 1 ? ' · ' : ''}</span>
            ))}
          </p>
        )}
      </div>
    )}
  </div>}
</div>

<script>
  const params = new URLSearchParams(window.location.search);
  const selectedDate = params.get('date') || (window.location.pathname.match(/\/(\d{4}-\d{2}-\d{2})\//) || [])[1];
  if (selectedDate) {
    const el = document.querySelector(`a[data-date="${selectedDate}"]`);
    if (el) {
      el.classList.add('date-pill--selected');
      el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }

  const copyBtn = document.getElementById('copy-link-btn');
  const copyLabel = document.getElementById('copy-link-label');
  if (copyBtn && copyLabel) {
    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(window.location.href).then(() => {
        copyLabel.textContent = 'Copied!';
        setTimeout(() => { copyLabel.textContent = 'Link'; }, 2000);
      });
    });
  }

  const calDataEl = document.getElementById('recurring-cal-data') as HTMLElement | null;
  const calWrap = document.getElementById('add-to-cal-wrap');
  if (calDataEl && calWrap) {
    const eventDates: string[] = JSON.parse(calDataEl.dataset.eventDates || '[]');
    const evTitle = calDataEl.dataset.title || '';
    const timeStr = calDataEl.dataset.time || '';
    const evAddress = calDataEl.dataset.address || '';
    const evLink = calDataEl.dataset.eventLink || '';

    const urlDate = params.get('date') || (window.location.pathname.match(/\/(\d{4}-\d{2}-\d{2})\//) || [])[1];
    const todayStr = new Date().toISOString().slice(0, 10);
    let pickedDate: string | null = (urlDate && eventDates.includes(urlDate)) ? urlDate : null;
    if (!pickedDate) {
      pickedDate = eventDates.find(d => d >= todayStr) || eventDates[eventDates.length - 1] || null;
    }

    if (pickedDate) {
      const buildCD = (dateStr: string, tStr: string) => {
        const compact = dateStr.replace(/-/g, '');
        const pad = (n: number) => String(n).padStart(2, '0');
        const parseT = (t: string): [number, number] | null => {
          const u = t.trim().toUpperCase().replace(/\s/g, '');
          const pm = u.endsWith('PM'), am = u.endsWith('AM');
          const d = u.replace(/[APM]/g, '');
          const [hS, mS = '00'] = d.split(':');
          const h = parseInt(hS), m = parseInt(mS);
          if (isNaN(h)) return null;
          let hour = h;
          if (pm && h !== 12) hour = h + 12;
          if (am && h === 12) hour = 0;
          return [hour, m];
        };
        const nextDay = () => {
          const nd = new Date(dateStr + 'T12:00:00');
          nd.setDate(nd.getDate() + 1);
          return nd.toISOString().slice(0, 10).replace(/-/g, '');
        };
        if (!tStr) return { start: compact, end: nextDay(), allDay: true };
        const parts = tStr.split(/\s*[-–—]\s*/);
        if (parts.length === 2) {
          let s = parts[0].trim(), e = parts[1].trim();
          if (!/[AaPpMm]/.test(s) && /[AaPpMm]/.test(e)) s += ' ' + (e.toUpperCase().includes('PM') ? 'PM' : 'AM');
          const sp = parseT(s), ep = parseT(e);
          if (sp && ep) return { start: `${compact}T${pad(sp[0])}${pad(sp[1])}00`, end: `${compact}T${pad(ep[0])}${pad(ep[1])}00`, allDay: false };
        }
        const p = parseT(tStr);
        if (p) return { start: `${compact}T${pad(p[0])}${pad(p[1])}00`, end: `${compact}T${pad((p[0] + 2) % 24)}${pad(p[1])}00`, allDay: false };
        return { start: compact, end: nextDay(), allDay: true };
      };

      const cd = buildCD(pickedDate, timeStr);
      const enc = encodeURIComponent;
      const gUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${enc(evTitle)}&dates=${cd.start}/${cd.end}${evAddress ? `&location=${enc(evAddress)}` : ''}${evLink ? `&details=${enc(evLink)}` : ''}`;
      const fmtO = (s: string) => s.length === 8
        ? `${s.slice(0,4)}-${s.slice(4,6)}-${s.slice(6,8)}`
        : `${s.slice(0,4)}-${s.slice(4,6)}-${s.slice(6,8)}T${s.slice(9,11)}:${s.slice(11,13)}:00`;
      const oUrl = `https://outlook.live.com/calendar/0/deeplink/compose?subject=${enc(evTitle)}&startdt=${fmtO(cd.start)}&enddt=${fmtO(cd.end)}${evAddress ? `&location=${enc(evAddress)}` : ''}${evLink ? `&body=${enc(evLink)}` : ''}`;
      const esc = (s: string) => s.replace(/[,;\\]/g, c => '\\' + c);
      const icsLines = [
        'BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//ThingsHappening//EN', 'BEGIN:VEVENT',
        `SUMMARY:${esc(evTitle)}`,
        cd.allDay ? `DTSTART;VALUE=DATE:${cd.start}` : `DTSTART:${cd.start}`,
        cd.allDay ? `DTEND;VALUE=DATE:${cd.end}` : `DTEND:${cd.end}`,
        evAddress ? `LOCATION:${esc(evAddress)}` : null,
        evLink ? `URL:${evLink}` : null,
        evLink ? `DESCRIPTION:${evLink}` : null,
        'END:VEVENT', 'END:VCALENDAR',
      ].filter(Boolean).join('\r\n');
      const iHref = `data:text/calendar;charset=utf8,${encodeURIComponent(icsLines)}`;

      const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`;
      const cls = 'inline-flex items-center gap-1.5 text-sm text-white hover:text-customGreen1 transition-colors border border-gray-300 hover:border-customGreen1 rounded-full px-4 py-2 no-underline';
      calWrap.innerHTML = `<a href="${gUrl}" target="_blank" rel="noopener noreferrer" class="${cls}">${svg} Google</a><a href="${iHref}" download="event.ics" class="${cls}">${svg} Apple</a><a href="${oUrl}" target="_blank" rel="noopener noreferrer" class="${cls}">${svg} Outlook</a>`;
    }
  }
</script>
{!hideSignup && !pathname?.includes('/events/') && (
  <div class="max-w-5xl mx-auto px-3 mt-8 mb-4">
    <p class="text-logoDarkGreen-600 text-2xl mb-3">Get our local guides and events updates.</p>
    <EmailSignup />
  </div>
)}

