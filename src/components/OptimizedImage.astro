---
import { Image } from "astro:assets";

type Props = {
  src: string;
  alt: string;
  loading?: "lazy" | "eager";
  width?: number;
  height?: number;
  className?: string;
  class?: string;
  [key: string]: any;
};

const { src, alt, loading = "lazy", width, height, className, class: classAttr, ...rest } = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  [
    '/src/assets/images/**/*.{jpg,jpeg,png,webp}',
    '/src/assets/editorials/**/*.{jpg,jpeg,png,webp}',
  ],
  { eager: true }
);

const key = `/src/assets${src}`;
const imgModule = allImages[key];
const resolvedClass = classAttr ?? className ?? "";
---

{imgModule
  ? <Image src={imgModule.default} alt={alt} class={resolvedClass} loading={loading} width={width} height={height} format="webp" {...rest} />
  : <img src={src} alt={alt} class={resolvedClass} loading={loading} width={width} height={height} />
}
