---
import CalendarPicker from './CalendarPicker.astro';

export type ActiveTab = 'all' | 'this-weekend' | 'this-week' | 'this-month' | 'date' | 'tags' | 'nearby';

interface Props {
  active: ActiveTab;
}

const { active } = Astro.props;

const linkClass = (tab: ActiveTab) =>
  active === tab
    ? 'text-customGreen1 font-medium border-b-2 border-logoDarkGreen pb-1'
    : 'text-gray-600 hover:text-customGreen1 pb-1 border-b-2 border-transparent hover:border-logoDarkGreen transition-colors';
---

<nav class="flex flex-wrap gap-x-3 gap-y-2 pt-16 text-xl md:gap-x-5 md:text-[1.7rem]" aria-label="Event filters">
  <CalendarPicker active={active} />
  <a href="/chattanooga#events" class={linkClass('all')}>All Events</a>
  <a href="/chattanooga/events/this-weekend" class={linkClass('this-weekend')}>This Weekend</a>
  <a href="/chattanooga/events/this-week" class={linkClass('this-week')}>This Week</a>
  <!-- <a href="/chattanooga/events/this-month" class={linkClass('this-month')}>This Month</a> -->
  <a href="/chattanooga/events/tags" class={linkClass('tags')}>Browse Tags</a>
  <a href="/chattanooga/events/nearby" class={linkClass('nearby')}>Nearby Cities</a>
</nav>
