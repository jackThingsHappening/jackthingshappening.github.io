---
interface Props {
  subheading?: string;
  headingClass?: string;
  subheadingClass?: string;
}

const {
  subheading,
  headingClass = 'font-jakarta font-bold text-[3.3rem] leading-[1.2]',
  subheadingClass = 'text-gray-600 text-xl3 mt-3 mb-6',
} = Astro.props;
---

<header class="pt-8">
  <h1 class={headingClass}>
    <slot />
  </h1>
  {subheading && <p class={subheadingClass}>{subheading}</p>}
</header>
