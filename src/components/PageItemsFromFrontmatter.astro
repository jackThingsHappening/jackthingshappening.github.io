---
import PageItems from './PageItems.astro';

export interface Props {
  pageItems?: Array<{
    title: string;
    description: string;
    order: number;
    tags: string[];
    photoOptions?: {
      photos: string[];
      appearance?: 'before' | 'after' | 'inline';
    };
    links?: Array<{
      text: string;
      link: string;
      target?: string;
    }>;
  }>;
  showClearFilters?: boolean;
}

const { pageItems, showClearFilters = false } = Astro.props;

if (!pageItems || pageItems.length === 0) {
  return null;
}

const mappedPageItems = pageItems.map(item => ({
  title: item.title,
  description: item.description,
  number: item.order,
  tags: item.tags,
  photoOptions: item.photoOptions,
  links: item.links
}));
---

<div id="items-sentinel"></div>
<PageItems items={mappedPageItems} showClearFilters={showClearFilters} />

<button
  id="back-to-filters-btn"
  aria-label="Back to filters"
  style="display:none; position:fixed; bottom:1.5rem; left:1.5rem; width:1.9rem; height:1.9rem; border-radius:9999px; background-color:#3CB371; border:none; cursor:pointer; z-index:50; align-items:center; justify-content:center; box-shadow:0 2px 8px rgba(0,0,0,0.18);"
>
  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="18 15 12 9 6 15"></polyline>
  </svg>
</button>

<script>
  const btn = document.getElementById('back-to-filters-btn') as HTMLButtonElement | null;
  const sentinel = document.getElementById('items-sentinel');

  if (btn && sentinel) {
    const isMobile = () => window.matchMedia('(max-width: 768px)').matches;
    let pastFilters = false;

    const observer = new IntersectionObserver(
      ([entry]) => {
        pastFilters = !entry.isIntersecting;
        btn.style.display = (pastFilters && isMobile()) ? 'flex' : 'none';
      },
      { threshold: 0 }
    );
    observer.observe(sentinel);

    window.addEventListener('resize', () => {
      btn.style.display = (pastFilters && isMobile()) ? 'flex' : 'none';
    });

    btn.addEventListener('click', () => {
      const filters = document.getElementById('guide-filters');
      if (filters) {
        filters.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  }
</script>

