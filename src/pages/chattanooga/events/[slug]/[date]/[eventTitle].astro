---
import BlogPostLayout from "../../../../../layouts/BlogPostLayout.astro";

export async function getStaticPaths() {
  const allPosts = await Astro.glob('../../**/*.mdx');

  const paths = [];

  for (const post of allPosts) {
    const dates = post.frontmatter.eventDatesDetails;
    if (!dates || dates.length === 0) continue;

    const slug = post.url.split('/').filter(Boolean).pop();

    for (const detail of dates) {
      if (!detail.eventTitle) continue;

      const eventTitleSlug = detail.eventTitle
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-|-$/g, '');

      paths.push({
        params: { slug, date: detail.date, eventTitle: eventTitleSlug },
        props: { post, detail },
      });
    }
  }

  return paths;
}

const { date } = Astro.params;
const { post, detail } = Astro.props;

const postDetails = {
  ...post.frontmatter,
  matchedDetails: detail,
  pubDate: date,
};
---

<BlogPostLayout content={postDetails}>
  <post.Content />
</BlogPostLayout>
