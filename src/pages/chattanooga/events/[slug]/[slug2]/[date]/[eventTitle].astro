---
import BlogPostLayout from "../../../../../../layouts/BlogPostLayout.astro";

export async function getStaticPaths() {
  const allPosts = await Astro.glob('../../../**/*.mdx');

  const paths = [];

  for (const post of allPosts) {
    const dates = post.frontmatter.eventDatesDetails;
    if (!dates || dates.length === 0) continue;

    const urlParts = post.url.split('/').filter(Boolean);
    const eventsIdx = urlParts.indexOf('events');
    const afterEvents = urlParts.slice(eventsIdx + 1);

    if (afterEvents.length !== 2) continue;

    const [slug, slug2] = afterEvents;

    for (const detail of dates) {
      const eventTitleSlug = detail.eventTitle
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-|-$/g, '');

      paths.push({
        params: { slug, slug2, date: detail.date, eventTitle: eventTitleSlug },
        props: { post, detail },
      });
    }
  }

  return paths;
}

const { date } = Astro.params;
const { post, detail } = Astro.props;

const postDetails = {
  ...post.frontmatter,
  matchedDetails: detail,
  pubDate: date,
};
---

<BlogPostLayout content={postDetails}>
  <post.Content />
</BlogPostLayout>
