---
import BaseHead from '../../../../components/Head/BaseHead.astro';
import Nav from '../../../../components/Nav.astro';
import EventsNav from '../../../../components/EventsNav.astro';
import Card from '../../../../components/Card.astro';
import Footer from '../../../../components/Footer/Footer.astro';
import EmailSignup from '../../../../components/EmailSignup.astro';
import ExploreHeader from '../../../../components/ExploreHeader.astro';

const title = 'Future Weekends in Chattanooga';
const seoDescription = 'Upcoming weekend events in Chattanooga, TN.';

let allPosts = (await Astro.glob('../*.mdx')).filter(
  (post) => post.frontmatter.published !== false
);

let allPostsIncludingMultipleDates = [];

allPosts.forEach((p) => {
  const baseData = { ...p.frontmatter, url: p.url };
  if (baseData.eventDates) {
    baseData.eventDates.forEach((date) => {
      allPostsIncludingMultipleDates.push({ ...baseData, pubDate: date, url: `${baseData.url}?date=${date}` });
    });
  } else {
    allPostsIncludingMultipleDates.push(baseData);
  }
});

const today = new Date();
today.setHours(0, 0, 0, 0);

allPostsIncludingMultipleDates = allPostsIncludingMultipleDates
  .filter(({ pubDate }) => {
    const d = new Date(pubDate);
    if (d < today) return false;
    const day = d.getDay();
    return day === 0 || day === 5 || day === 6;
  })
  .sort((a, b) => new Date(a.pubDate) - new Date(b.pubDate));
---

<html lang="en">
<head>
  <BaseHead title={title} description={seoDescription} />
</head>
<body class="text-black font-body leading-normal personality-casual">
  <Nav />
  <main>
    <article class="w-full px-4 md:px-8 lg:px-16 mt-8 pb-4">
      <ExploreHeader subheading="Upcoming weekend events in Chattanooga">
        Future Weekends in <span class="text-customGreen1">Chattanooga</span><span class="text-customGreen1">.</span>
      </ExploreHeader>
      <EventsNav active="all-weekends" />
      <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-8 py-8" data-test="articles-section">
        {allPostsIncludingMultipleDates.map(p => (
          <div class="col-span-1"><Card post={p} /></div>
        ))}
        {allPostsIncludingMultipleDates.length === 0 && (
          <p class="col-span-3 text-xl text-gray-500">No upcoming weekend events yet — check back soon.</p>
        )}
      </section>
      <div class="mt-12 pt-8 border-t border-gray-200">
        <p class="text-gray-600 text-xl mb-3">Get more local guides and events in your inbox.</p>
        <EmailSignup />
      </div>
    </article>
  </main>
  <Footer />
</body>
</html>
