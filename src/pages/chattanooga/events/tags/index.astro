---
import BaseHead from '../../../../components/Head/BaseHead.astro';
import Nav from '../../../../components/Nav.astro';
import EventsNav from '../../../../components/EventsNav.astro';
import Footer from '../../../../components/Footer/Footer.astro';
import EmailSignup from '../../../../components/EmailSignup.astro';
import ExploreHeader from '../../../../components/ExploreHeader.astro';
import { expandEvents } from '../../../../utils/expandEvents';

const title = 'Browse Events by Tag - Chattanooga';
const seoDescription = 'Browse all Chattanooga events by genre or place.';

const allEvents = [
  ...(Object.values(import.meta.glob('../../../../pages-events/**/*.mdx', { eager: true }))),
  ...(Object.values(import.meta.glob('../**/*.mdx', { eager: true }))),
].filter((post) => post.frontmatter.published !== false);

const today = new Date();
today.setHours(0, 0, 0, 0);

const upcoming = expandEvents(allEvents).filter(
  (e) => new Date(e.pubDate + 'T00:00:00') >= today
);

function countByTag(tag: string) {
  return upcoming.filter((e) =>
    e.tags?.some((t: any) => t.tag === tag)
  ).length;
}

type TagEntry = { tag: string; count: number };

const genreTags: TagEntry[] = [];
const placeTags: TagEntry[] = [];
const seen = new Set<string>();

for (const post of allEvents) {
  const tags = post.frontmatter.tags ?? [];
  for (const t of tags) {
    if (!t.type || seen.has(t.tag)) continue;
    seen.add(t.tag);
    const entry = { tag: t.tag, count: countByTag(t.tag) };
    if (t.type === 'genre') genreTags.push(entry);
    else if (t.type === 'place') placeTags.push(entry);
  }
}

genreTags.sort((a, b) => b.count - a.count);
placeTags.sort((a, b) => b.count - a.count);
---

<html lang="en" class="dot-grid-bg">
<head>
  <BaseHead title={title} description={seoDescription} />
</head>
<body class="text-black font-body leading-normal personality-casual">
  <Nav />
  <main>
    <article class="w-full px-4 md:px-8 lg:px-16 mt-8 pb-4">
      <ExploreHeader>Browse events by tag</ExploreHeader>
      <p class="text-gray-600 text-xl3 mt-4 mb-2">Tags organize every Chattanooga event into two groups: genre and place. Genre tags sort by type: <a href="/chattanooga/events/tag/music" class="text-customGreen1 underline decoration-logoDarkGreen underline-offset-4 hover:opacity-70 transition-opacity">music</a>, <a href="/chattanooga/events/tag/food" class="text-customGreen1 underline decoration-logoDarkGreen underline-offset-4 hover:opacity-70 transition-opacity">food</a>, <a href="/chattanooga/events/tag/outdoors" class="text-customGreen1 underline decoration-logoDarkGreen underline-offset-4 hover:opacity-70 transition-opacity">outdoors</a>, <a href="/chattanooga/events/tag/sports" class="text-customGreen1 underline decoration-logoDarkGreen underline-offset-4 hover:opacity-70 transition-opacity">sports</a>, <a href="/chattanooga/events/tag/arts" class="text-customGreen1 underline decoration-logoDarkGreen underline-offset-4 hover:opacity-70 transition-opacity">arts</a>, and more. Place tags filter by venue or neighborhood, so you can find everything happening at a specific spot. Each tag shows a live count of upcoming events. Use them to skip straight to what interests you instead of scrolling the full list. Browse both groups below, or sort by count to see what's most active right now.</p>
      <EventsNav active="tags" />

      <div class="mt-8 flex flex-wrap items-center gap-2">
<button data-sort="count-desc" class="sort-btn px-3 py-1 rounded-full border border-logoDarkGreen text-sm bg-logoDarkGreen text-white transition-colors">Count ↓</button>
        <button data-sort="count-asc"  class="sort-btn px-3 py-1 rounded-full border border-logoDarkGreen text-sm bg-white text-logoDarkGreen transition-colors">Count ↑</button>
        <button data-sort="abc-asc"    class="sort-btn px-3 py-1 rounded-full border border-logoDarkGreen text-sm bg-white text-logoDarkGreen transition-colors">A–Z</button>
        <button data-sort="abc-desc"   class="sort-btn px-3 py-1 rounded-full border border-logoDarkGreen text-sm bg-white text-logoDarkGreen transition-colors">Z–A</button>
      </div>

      <section class="mt-8">
        <h2 class="text-2xl font-semibold text-gray-700 mb-4">Genre</h2>
        <div id="genre-tags" class="flex flex-wrap gap-3">
          {genreTags.map(({ tag, count }) => (
            <a
              href={`/chattanooga/events/tag/${tag}`}
              class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-logoDarkGreen bg-white text-logoDarkGreen hover:bg-logoDarkGreen hover:text-white transition-colors text-lg"
            >
              #{tag}
              {count > 0 && <span class="text-sm font-bold">({count})</span>}
            </a>
          ))}
        </div>
      </section>

      <section class="mt-10">
        <h2 class="text-2xl font-semibold text-gray-700 mb-4">Place</h2>
        <div id="place-tags" class="flex flex-wrap gap-3">
          {placeTags.map(({ tag, count }) => (
            <a
              href={`/chattanooga/events/tag/${tag}`}
              class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-logoDarkGreen bg-white text-logoDarkGreen hover:bg-customGreen1 hover:text-white transition-colors text-lg"
            >
              #{tag}
              {count > 0 && <span class="text-sm font-bold">({count})</span>}
            </a>
          ))}
        </div>
      </section>

      <div class="mt-16 pt-8 border-t border-gray-200">
        <p class="text-gray-600 text-xl mb-3">Get more local guides and events in your inbox.</p>
        <EmailSignup />
      </div>
    </article>
  </main>
  <Footer />
</body>
</html>

<script define:vars={{ genreTagsData: genreTags, placeTagsData: placeTags }}>
  function sortTags(tags, key) {
    const s = [...tags];
    if (key === 'count-desc') s.sort((a, b) => b.count - a.count);
    else if (key === 'count-asc') s.sort((a, b) => a.count - b.count);
    else if (key === 'abc-asc') s.sort((a, b) => a.tag.localeCompare(b.tag));
    else if (key === 'abc-desc') s.sort((a, b) => b.tag.localeCompare(a.tag));
    return s;
  }

  function tagLink(tag, count, hoverClass) {
    return `<a href="/chattanooga/events/tag/${tag}" class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-logoDarkGreen bg-white text-logoDarkGreen ${hoverClass} hover:text-white transition-colors text-lg">#${tag}${count > 0 ? `<span class="text-sm font-bold">(${count})</span>` : ''}</a>`;
  }

  function render(key) {
    document.getElementById('genre-tags').innerHTML =
      sortTags(genreTagsData, key).map(({ tag, count }) => tagLink(tag, count, 'hover:bg-logoDarkGreen')).join('');
    document.getElementById('place-tags').innerHTML =
      sortTags(placeTagsData, key).map(({ tag, count }) => tagLink(tag, count, 'hover:bg-customGreen1')).join('');

    document.querySelectorAll('.sort-btn').forEach(btn => {
      const active = btn.dataset.sort === key;
      btn.classList.toggle('bg-logoDarkGreen', active);
      btn.classList.toggle('text-white', active);
      btn.classList.toggle('bg-white', !active);
      btn.classList.toggle('text-logoDarkGreen', !active);
    });
  }

  document.querySelectorAll('.sort-btn').forEach(btn => {
    btn.addEventListener('click', () => render(btn.dataset.sort));
  });
</script>
