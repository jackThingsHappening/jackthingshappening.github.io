---
import BaseHead from '../../../../components/Head/BaseHead.astro';
import Nav from '../../../../components/Nav.astro';
import EventsNav from '../../../../components/EventsNav.astro';
import Card from '../../../../components/Card.astro';
import Footer from '../../../../components/Footer/Footer.astro';
import EmailSignup from '../../../../components/EmailSignup.astro';
import ExploreHeader from '../../../../components/ExploreHeader.astro';
import { expandEvents } from '../../../../utils/expandEvents';

const title = 'This Week in Chattanooga';
const seoDescription = 'Events happening this week in Chattanooga, TN.';

let allPosts = (Object.values(import.meta.glob('../**/*.mdx', { eager: true }))).filter(
  (post) => post.frontmatter.published !== false
);

let allPostsIncludingMultipleDates = expandEvents(allPosts);

const today = new Date();
today.setHours(0, 0, 0, 0);
const firstDayOfWeek = new Date(today.getFullYear(), today.getMonth(), today.getDate() - today.getDay());
const lastDayOfWeek = new Date(today.getFullYear(), today.getMonth(), today.getDate() - today.getDay() + 6);
lastDayOfWeek.setHours(23, 59, 59, 999);

allPostsIncludingMultipleDates = allPostsIncludingMultipleDates
  .filter(({ pubDate }) => {
    const d = new Date(pubDate + 'T00:00:00');
    return d >= firstDayOfWeek && d <= lastDayOfWeek;
  })
  .sort((a, b) => new Date(a.pubDate + 'T00:00:00') - new Date(b.pubDate + 'T00:00:00'));
---

<html lang="en" class="dot-grid-bg">
<head>
  <BaseHead title={title} description={seoDescription} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://thingshappening.com" },
      { "@type": "ListItem", "position": 2, "name": "Chattanooga", "item": "https://thingshappening.com/chattanooga" },
      { "@type": "ListItem", "position": 3, "name": "Events This Week", "item": "https://thingshappening.com/chattanooga/events/this-week" }
    ]
  })} />
</head>
<body class="text-black font-body leading-normal personality-casual">
  <Nav />
  <main>
    <article class="w-full px-4 md:px-8 lg:px-16 mt-8 pb-4">
      <ExploreHeader>
        <span class="text-customGreen1 shimmer-text">#this-week</span> events in Chattanooga
      </ExploreHeader>
      <p class="text-gray-600 text-xl3 mt-4 mb-2">Everything happening in Chattanooga this week, in one place. Live music, outdoor events, arts, food, sports, and more. Monday through Sunday. Updated daily as new events are added. Save anything that catches your eye or send it straight to your <a href="/chattanooga/my-favorites" class="text-customGreen1 underline decoration-logoDarkGreen underline-offset-4 hover:opacity-70 transition-opacity">calendar</a>.</p>
      <EventsNav active="this-week" />
      <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-8 py-8" data-test="articles-section">
        {allPostsIncludingMultipleDates.map(p => (
          <div class="col-span-1"><Card post={p} /></div>
        ))}
        {allPostsIncludingMultipleDates.length === 0 && (
          <p class="col-span-3 text-xl text-gray-500">No events this week — check back soon.</p>
        )}
      </section>
      <div class="mt-12 pt-8 border-t border-gray-200">
        <p class="text-gray-600 text-xl mb-3">Get more local guides and events in your inbox.</p>
        <EmailSignup />
      </div>
    </article>
  </main>
  <Footer />
</body>
</html>
