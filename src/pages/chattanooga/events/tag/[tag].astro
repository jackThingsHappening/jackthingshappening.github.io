---
import BaseHead from '../../../../components/Head/BaseHead.astro';
import Nav from '../../../../components/Nav.astro';
import EventsNav from '../../../../components/EventsNav.astro';
import Card from '../../../../components/Card.astro';
import Footer from '../../../../components/Footer/Footer.astro';
import EmailSignup from '../../../../components/EmailSignup.astro';
import ExploreHeader from '../../../../components/ExploreHeader.astro';
import { expandEvents } from '../../../../utils/expandEvents';

export async function getStaticPaths() {
  const allEvents = [
    ...(await Astro.glob('../../../../pages-events/**/*.mdx')),
    ...(await Astro.glob('../**/*.mdx')),
  ].filter((post) => post.frontmatter.published !== false);

  const tagSet = new Set(
    allEvents.flatMap((post) =>
      post.frontmatter.tags
        ? post.frontmatter.tags
            .filter((t) => t.type === 'genre' || t.type === 'place' || t.type === 'city')
            .map((t) => t.tag)
        : []
    )
  );

  return Array.from(tagSet)
    .filter((tag): tag is string => Boolean(tag))
    .map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;

const allEvents = [
  ...(await Astro.glob('../../../../pages-events/**/*.mdx')),
  ...(await Astro.glob('../**/*.mdx')),
].filter(
  (post) =>
    post.frontmatter.published !== false &&
    post.frontmatter.tags?.some((t) => t.tag === tag)
);

const today = new Date();
today.setHours(0, 0, 0, 0);

const allPostsIncludingMultipleDates = expandEvents(allEvents)
  .filter((e) => new Date(e.pubDate + 'T00:00:00') >= today)
  .sort((a, b) => new Date(a.pubDate + 'T00:00:00') - new Date(b.pubDate + 'T00:00:00'));

const cityNames: Record<string, string> = {
  'cleveland-tn': 'Cleveland, TN',
  'dalton-ga': 'Dalton, GA',
  'ringgold-ga': 'Ringgold, GA',
  'athens-tn': 'Athens, TN',
  'ooltewah-tn': 'Ooltewah, TN',
  'south-pittsburg-tn': 'South Pittsburg, TN',
  'lookout-mountain-ga': 'Lookout Mountain, GA',
  'chickamauga-ga': 'Chickamauga, GA',
  'guild-tn': 'Guild, TN',
  'whitwell-tn': 'Whitwell, TN',
  'jasper-tn': 'Jasper, TN',
};
const displayTag = cityNames[tag] ?? (tag.charAt(0).toUpperCase() + tag.slice(1));
const title = cityNames[tag] ? `Events in ${displayTag}` : `${displayTag} Events Near Chattanooga`;
const seoDescription = cityNames[tag]
  ? `Upcoming events in ${displayTag} near Chattanooga, TN.`
  : `${displayTag} events happening near Chattanooga, TN.`;
---

<html lang="en" class="dot-grid-bg">
<head>
  <BaseHead title={title} description={seoDescription} />
</head>
<body class="text-black font-body leading-normal personality-casual">
  <Nav />
  <main>
    <article class="w-full px-4 md:px-8 lg:px-16 mt-8 pb-4">
      <ExploreHeader>
        <span class="text-customGreen1 shimmer-text">#{tag}</span> events in Chattanooga
      </ExploreHeader>
      <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-8 py-8" data-test="articles-section">
        {allPostsIncludingMultipleDates.map(p => (
          <div class="col-span-1"><Card post={p} highlighted={tag} /></div>
        ))}
        {allPostsIncludingMultipleDates.length === 0 && (
          <p class="col-span-3 text-xl text-gray-500">No {displayTag.toLowerCase()} events found.</p>
        )}
      </section>
      <div class="mt-12 pt-8 border-t border-gray-200">
        <p class="text-logoDarkGreen-600 text-2xl mb-3">Get our local guides and events updates.</p>
        <EmailSignup />
      </div>
    </article>
  </main>
  <Footer />
</body>
</html>
