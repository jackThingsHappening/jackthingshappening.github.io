---
import BaseHead from '../../components/Head/BaseHead.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer/Footer.astro';
---

<html lang="en">
  <head>
    <BaseHead title="My Favorites | Things Happening Chattanooga" description="Your saved events and guide items." />
  </head>
  <body>
    <Nav />
    <main>
      <div class="header-styles pt-14 pb-10">
        <div class="max-w-5xl mx-auto px-3">
          <h1 style="font-family: 'Libre Baskerville', serif; font-size: clamp(2.75rem, 5vw, 4.5rem);">My Favorites</h1>
          <div class="text-lg text-white-700 mt-4 max-w-2xl space-y-2">
            <p><span class="underline decoration-customGreen1 decoration-2 underline-offset-4">Star</span> any <a href="/chattanooga/events/page/1" class="underline decoration-customGreen1 decoration-2 underline-offset-4 hover:text-customGreen1">event</a> or <a href="/chattanooga/guides/tag/interactive" class="underline decoration-customGreen1 decoration-2 underline-offset-4 hover:text-customGreen1">guide</a> item to save it here. Your favorites stay saved between visits. Nothing is stored on a server, it all lives in your browser's local storage.</p>
            <p>To save an event, click the star icon on any event card. To save a guide item, click the star on any item inside an <a href="/chattanooga/guides/tag/interactive" class="hover:text-customGreen1">interactive guide</a>.</p>
          </div>
        </div>
      </div>

      <div class="max-w-5xl mx-auto px-3 py-10">
        <div id="empty-state" class="hidden text-black text-xl py-10 text-center">
          Nothing saved yet. Browse events and guides and click the star to save items.
        </div>

        <div id="sort-controls" class="hidden flex flex-wrap items-center gap-2 mb-8">
          <button data-sort="recent" class="sort-btn px-3 py-1 rounded-full border border-logoDarkGreen text-sm bg-logoDarkGreen text-white transition-colors">Recent</button>
          <button data-sort="abc" class="sort-btn px-3 py-1 rounded-full border border-logoDarkGreen text-sm bg-white text-logoDarkGreen transition-colors">A–Z</button>
        </div>

        <section id="events-section" class="hidden mb-12">
          <h2 class="text-3xl mb-6" style="font-family: 'Libre Baskerville', serif;">Saved Events</h2>
          <ul id="events-list" class="space-y-3 list-none p-0 m-0"></ul>
        </section>

        <section id="guides-section" class="hidden">
          <h2 class="text-3xl mb-6" style="font-family: 'Libre Baskerville', serif;">Saved Guide Items</h2>
          <ul id="guides-list" class="space-y-3 list-none p-0 m-0"></ul>
        </section>
      </div>
    </main>
    <Footer />
  </body>
</html>

<script>
  interface SavedEvent { key: string; title: string; pubDate: string; url: string; }
  interface SavedGuideItem { key: string; title: string; guidePath: string; number: number; }

  function getSavedEvents(): SavedEvent[] {
    try {
      const raw = JSON.parse(localStorage.getItem('savedEvents') || '[]');
      return Array.isArray(raw) ? raw.filter((x) => typeof x === 'object' && x.key) : [];
    } catch { return []; }
  }

  function getSavedGuideItems(): SavedGuideItem[] {
    try {
      const raw = JSON.parse(localStorage.getItem('savedGuideItems') || '[]');
      return Array.isArray(raw) ? raw.filter((x) => typeof x === 'object' && x.key) : [];
    } catch { return []; }
  }

  function formatDate(dateStr: string): string {
    if (!dateStr) return '';
    const d = new Date(dateStr + 'T00:00:00');
    return d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
  }

  function guideNameFromPath(path: string): string {
    const slug = path.replace(/\/$/, '').split('/').pop() || path;
    return slug.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
  }

  function removeEvent(key: string, li: HTMLElement): void {
    const current = getSavedEvents();
    localStorage.setItem('savedEvents', JSON.stringify(current.filter((s) => s.key !== key)));
    li.remove();
    checkEmpty();
  }

  function removeGuideItem(key: string, li: HTMLElement): void {
    const current = getSavedGuideItems();
    localStorage.setItem('savedGuideItems', JSON.stringify(current.filter((s) => s.key !== key)));
    li.remove();
    checkEmpty();
  }

  function checkEmpty(): void {
    const eventsList = document.getElementById('events-list')!;
    const guidesList = document.getElementById('guides-list')!;
    const eventsSection = document.getElementById('events-section')!;
    const guidesSection = document.getElementById('guides-section')!;
    const emptyState = document.getElementById('empty-state')!;

    const hasEvents = eventsList.children.length > 0;
    const hasGuides = guidesList.children.length > 0;

    eventsSection.classList.toggle('hidden', !hasEvents);
    guidesSection.classList.toggle('hidden', !hasGuides);
    emptyState.classList.toggle('hidden', hasEvents || hasGuides);
  }

  function buildEventItem(event: SavedEvent): HTMLLIElement {
    const navUrl = event.url.includes('|') ? event.url.split('|')[0] : event.url;
    const today = new Date(); today.setHours(0, 0, 0, 0);
    const isPast = event.pubDate && new Date(event.pubDate + 'T00:00:00') < today;
    const li = document.createElement('li');
    li.className = 'flex items-start justify-between gap-4 border border-black rounded-xl px-5 py-4 hover:border-[#3CB371] transition-colors max-w-2xl';
    li.innerHTML = `
      <a href="${navUrl}" class="flex-1 min-w-0 group">
        <p class="text-xl font-medium group-hover:text-[#3CB371] transition-colors flex items-center gap-2">${event.title}${isPast ? `<span class="inline-block text-sm px-3 py-0.5 rounded-full bg-customGreen1 text-white">Past</span>` : ''}</p>
        ${event.pubDate ? `<p class="text-base text-black mt-0.5">${formatDate(event.pubDate)}</p>` : ''}
      </a>
      <button class="remove-btn flex-shrink-0 text-black hover:text-red-400 transition-colors text-2xl leading-none mt-0.5" aria-label="Remove">×</button>
    `;
    li.querySelector('.remove-btn')!.addEventListener('click', () => removeEvent(event.key, li));
    return li;
  }

  function buildGuideItem(item: SavedGuideItem): HTMLLIElement {
    const guideUrl = item.guidePath + '#item-' + item.number;
    const guideName = guideNameFromPath(item.guidePath);
    const li = document.createElement('li');
    li.className = 'flex items-start justify-between gap-4 border border-black rounded-xl px-5 py-4 hover:border-[#3CB371] transition-colors max-w-2xl';
    li.innerHTML = `
      <a href="${guideUrl}" class="flex-1 min-w-0 group">
        <p class="text-xl font-medium group-hover:text-[#3CB371] transition-colors">${item.title}</p>
        <p class="text-base text-black mt-0.5">${guideName}</p>
      </a>
      <button class="remove-btn flex-shrink-0 text-black hover:text-red-400 transition-colors text-2xl leading-none mt-0.5" aria-label="Remove">×</button>
    `;
    li.querySelector('.remove-btn')!.addEventListener('click', () => removeGuideItem(item.key, li));
    return li;
  }

  let allEvents: SavedEvent[] = [];
  let allGuideItems: SavedGuideItem[] = [];

  function renderLists(sortKey: string): void {
    const eventsList = document.getElementById('events-list')!;
    const guidesList = document.getElementById('guides-list')!;

    const sortedEvents = sortKey === 'abc'
      ? [...allEvents].sort((a, b) => a.title.localeCompare(b.title))
      : [...allEvents].reverse();

    const sortedGuides = sortKey === 'abc'
      ? [...allGuideItems].sort((a, b) => a.title.localeCompare(b.title))
      : [...allGuideItems].reverse();

    eventsList.innerHTML = '';
    guidesList.innerHTML = '';
    sortedEvents.forEach((e) => eventsList.appendChild(buildEventItem(e)));
    sortedGuides.forEach((g) => guidesList.appendChild(buildGuideItem(g)));

    document.querySelectorAll('.sort-btn').forEach((btn) => {
      const active = (btn as HTMLElement).dataset.sort === sortKey;
      btn.classList.toggle('bg-logoDarkGreen', active);
      btn.classList.toggle('text-white', active);
      btn.classList.toggle('bg-white', !active);
      btn.classList.toggle('text-logoDarkGreen', !active);
    });

    checkEmpty();
  }

  document.addEventListener('DOMContentLoaded', () => {
    allEvents = getSavedEvents();
    allGuideItems = getSavedGuideItems();

    const sortControls = document.getElementById('sort-controls')!;
    if (allEvents.length > 0 || allGuideItems.length > 0) {
      sortControls.classList.remove('hidden');
    }

    renderLists('recent');

    document.querySelectorAll('.sort-btn').forEach((btn) => {
      btn.addEventListener('click', () => renderLists((btn as HTMLElement).dataset.sort!));
    });
  });
</script>
