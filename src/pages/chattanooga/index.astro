---
import BaseHead from '../../components/Head/BaseHead.astro';
import Nav from '../../components/Nav.astro';
import Card from '../../components/Card.astro';
import GuidesEditorialsNav from '../../components/GuidesEditorialsNav.astro';
import EventsNav from '../../components/EventsNav.astro';
import ExploreHeader from '../../components/ExploreHeader.astro';
import Footer from '../../components/Footer/Footer.astro';
import Paginator from '../../components/Paginator.astro';
import { expandEvents } from '../../utils/expandEvents';
import EmailSignup from '../../components/EmailSignup.astro';
import NearbyCitiesNav from '../../components/NearbyCitiesNav.astro';

interface MarkdownFrontmatter {
  date: number;
}

const title = 'Things Happening';
const seoDescription = 'Helping you explore and enjoy your local city! Things Happening guides you and your family to fun adventures and experiences in your city and beyond.';
const city = "Chattanooga";

const allGuides = (await Astro.glob('./guides/*.mdx')).filter(
  (post) => post.frontmatter.published !== false
);
const allEditorials = (await Astro.glob('./editorials/*.mdx')).filter(
  (post) => post.frontmatter.published !== false
);
const allEvents = (await Astro.glob('./events/**/*.mdx')).filter(
  (post) => post.frontmatter.published !== false
);

// Format guides
const guides = allGuides.map((p) => ({
  ...p.frontmatter,
  url: p.url,
  type: 'guide',
}));

// Format editorials
const editorials = allEditorials.map((p) => ({
  ...p.frontmatter,
  url: p.url,
  type: 'editorial',
}));

// Format events similar to pagination logic
const expanded = expandEvents(allEvents);

// Filter & sort events
const today = new Date();
today.setHours(0, 0, 0, 0);

const sortedEvents = expanded
  .filter((e) => new Date(e.pubDate + 'T00:00:00') >= today)
  .sort((a, b) => new Date(a.pubDate + 'T00:00:00') - new Date(b.pubDate + 'T00:00:00'));

// Merge guides and editorials, sort by lastUpdated
const allContent = [...guides, ...editorials];
const sortedContent = allContent.sort((a, b) => new Date(b.lastUpdated) - new Date(a.lastUpdated));

// Map content tags to three homepage groupings
const OUTDOORS_TAGS = ['outdoors', 'editorial'];
const LIVE_EVENTS_TAGS = ['music', 'arts', 'sports'];

function getSectionKey(item: { tags?: Array<{ type: string; tag: string }>; type?: string }) {
  const tags = item.tags ?? [];
  const first = tags.find((t) => t.tag !== 'longform');
  const tag = first ? first.tag : (item.type === 'editorial' ? 'editorial' : 'around-the-city');
  if (OUTDOORS_TAGS.includes(tag)) return 'outdoors';
  if (LIVE_EVENTS_TAGS.includes(tag)) return 'live-events-and-performances';
  return 'around-the-city';
}

const SECTION_LABELS: Record<string, string> = {
  'outdoors': 'Outdoors in the National Park City',
  'live-events-and-performances': 'Live Events and Performances',
  'around-the-city': 'Around the city',
};
const SECTION_TAG_SLUG: Record<string, string> = {
  'outdoors': 'outdoors',
  'live-events-and-performances': 'live-events',
  'around-the-city': 'around-the-city',
};
const SECTION_DESCRIPTIONS: Record<string, string> = {
  'outdoors': 'Hikes, parks, trails, and outdoor adventures in and around Chattanooga',
  'live-events-and-performances': 'Live music, theatre, performing arts, and sports to see in person',
  'around-the-city': 'Tours, history, food, and ways to explore the city like a local',
};
const SECTION_ORDER = ['live-events-and-performances', 'around-the-city', 'outdoors'];

// Group content by section, each section sorted by lastUpdated
const bySection: Record<string, typeof sortedContent> = {};
for (const item of sortedContent) {
  const key = getSectionKey(item);
  if (!bySection[key]) bySection[key] = [];
  bySection[key].push(item);
}
const SECTION_PREVIEW_SIZE = 3;

const eventsPage = sortedEvents.slice(0, 3);


const nearbyEvents = expanded.filter((e) => {
  const isUpcoming = new Date(e.pubDate + 'T00:00:00') >= today;
  const hasCity = e.tags?.some((t: any) => t.type === 'city');
  return isUpcoming && hasCity;
}).sort((a, b) => new Date(a.pubDate + 'T00:00:00') - new Date(b.pubDate + 'T00:00:00'));

const nearbyByCity = new Map<string, typeof nearbyEvents>();
for (const post of nearbyEvents) {
  const cityTag = post.tags?.find((t: any) => t.type === 'city')?.tag;
  if (!cityTag) continue;
  if (!nearbyByCity.has(cityTag)) nearbyByCity.set(cityTag, []);
  nearbyByCity.get(cityTag)!.push(post);
}
const nearbyCities = [...nearbyByCity.entries()].sort((a, b) => a[0].localeCompare(b[0]));

const page = {
  currentPage: 1,
  lastPage: Math.max(
    Math.ceil(sortedEvents.length / 9),
    Math.ceil(sortedContent.length / 9)
  ),
  url: '/chattanooga',
};
---

<html lang="en" class="dot-grid-bg">
<head>
  <BaseHead title={title} description={seoDescription} />
</head>

<body class="text-black font-body leading-normal personality-casual">
  <Nav />
  <main>
    {eventsPage.length > 0 && (
      <article id="events" class="w-full px-4 md:px-8 lg:px-16 mt-8 pb-4">
        <header class="pt-8">
          <h2 class="font-jakarta font-bold text-[3.3rem] leading-[1.2]">
            An easier way to find things
          </h2>
          <h2 class="font-jakarta font-bold text-[3.3rem] leading-[1.2]">
            happening in <span class="shimmer-text">Chattanooga</span><span class="text-customGreen1">.</span>
          </h2>
          <p class="text-gray-600 text-xl3 mt-6 mb-12">Also check out our <a href="/chattanooga/guides/tag/interactive" class="text-customGreen1 underline decoration-logoDarkGreen underline-offset-8 [text-decoration-skip-ink:none] hover:opacity-70 transition-opacity">interactive</a> and <a href="/chattanooga/guides/tag/longform" class="text-customGreen1 underline decoration-logoDarkGreen underline-offset-8 [text-decoration-skip-ink:none] hover:opacity-70 transition-opacity">longform</a> guides<span class="text-customGreen1 text-3xl">.</span></p>
          <EmailSignup />
        </header>
        <EventsNav active="all" />
        <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-8 py-8">
          {eventsPage.map((e) => (
            <div class="col-span-1">
              <Card post={e} />
            </div>
          ))}
        </section>
        <div class="mt-4">
          <a href="/chattanooga/events/page/1" class="text-customGreen1 font-semibold underline decoration-logoDarkGreen hover:opacity-90 transition-colors text-2xl">View More Events</a>
        </div>
      </article>
    )}

    {nearbyCities.length > 0 && (
      <article class="w-full px-4 md:px-8 lg:px-16 mt-8 pb-4">
        <h2 class="font-jakarta font-bold text-5xl md:text-6xl leading-[1.2] pt-8">
          Nearby cities and towns<span class="text-customGreen1">.</span>
        </h2>
        <NearbyCitiesNav activeCities={nearbyCities.map(([cityTag]) => cityTag)} />
        <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-8 mt-10">
          {nearbyEvents.slice(0, 3).map(p => (
            <div class="col-span-1"><Card post={p} /></div>
          ))}
        </section>
        <div class="mt-8">
          <a href="/chattanooga/events/nearby" class="text-customGreen1 font-semibold underline decoration-logoDarkGreen hover:opacity-90 transition-colors text-2xl">View all nearby cities</a>
        </div>
      </article>
    )}

    <article class="w-full px-4 md:px-8 lg:px-16 mt-8">
      <ExploreHeader>
        Explore <span class="text-customGreen1">{city}, TN</span> with our Guides<span class="text-customGreen1">.</span>
      </ExploreHeader>
      <GuidesEditorialsNav active="all" />
      {SECTION_ORDER.filter((key) => bySection[key]?.length).map((key) => {
        const items = bySection[key];
        const label = SECTION_LABELS[key] ?? key;
        const description = SECTION_DESCRIPTIONS[key] ?? '';
        return (
          <section class="pt-7 pb-4">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-8">
              {items.map((item) => (
                <div class="col-span-1">
                  <Card post={item} />
                </div>
              ))}
            </div>
            {/* {bySection[key].length > SECTION_PREVIEW_SIZE && (
              <div class="mt-4">
                <a href={SECTION_TAG_SLUG[key] ? `/chattanooga/guides/tag/${SECTION_TAG_SLUG[key]}` : '/chattanooga/guides'} class="text-customGreen1 font-semibold underline decoration-logoDarkGreen hover:opacity-90 transition-colors text-xl">View all in {label} →</a>
              </div>
            )} */}
          </section>
        );
      })}
      {sortedContent.length > 15 && (
        <div class="text-center mt-10 pt-6 border-t border-gray-200">
          <a href="/chattanooga/guides/page/2" class="text-customGreen1 font-semibold underline decoration-logoDarkGreen hover:opacity-90 transition-colors text-xl">View more →</a>
        </div>
      )}
    </article>

    <Paginator page={page} />
  </main>

  <Footer />
</body>
</html>
