---
import BaseHead from '../components/Head/BaseHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer/Footer.astro';

const title = 'Things Happening';
const seoDescription = 'A simpler way to find things happening in your city.';
---

<html lang="en">
<head>
  <BaseHead title={title} description={seoDescription} />
</head>

<body class="text-black font-body leading-normal personality-casual">
  <Nav />
  <main class="w-full px-4 md:px-8 lg:px-16 mt-8">
    <header class="pt-10 max-w-3xl">
      <h1 class="font-jakarta font-bold text-5xl md:text-6xl leading-[1.2]">
        A simple way to find things happening in your <span class="text-customGreen1">city</span><span class="text-customGreen1">.</span>
      </h1>
      <p class="text-gray-600 text-3xl mt-6">We're starting in Chattanooga, TN.</p>
    </header>

    <div class="mt-12 flex flex-col gap-4">
      <a href="/chattanooga" class="inline-flex items-center gap-3 border-2 border-black rounded-lg px-6 py-4 text-2xl font-semibold hover:bg-black hover:text-white transition-colors w-fit">
        <span class="text-customGreen1">→</span> Chattanooga, TN
      </a>
      <div class="inline-flex items-center gap-3 border-2 border-gray-300 rounded-lg px-6 py-4 text-2xl font-semibold text-gray-400 w-fit cursor-not-allowed">
        <span>→</span> Knoxville, TN <span class="text-lg font-normal ml-2">coming soon</span>
      </div>
    </div>

  </main>

  <Footer />
</body>
</html>
