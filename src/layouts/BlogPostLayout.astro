---
import Nav from '../components/Nav.astro';
import BaseHead from '../components/Head/BaseHead.astro';
import BlogPost from '../components/BlogPost.astro';
import Footer from '../components/Footer/Footer.astro';

const {content} = Astro.props;
let {address, author, eventLink, readTime, originalDate, matchedDetails, eventDatesDetails, eventDates, entranceCost, lastUpdated, ticketsLink, tags, title, time, description, pubDate, venue, venueDetails, hero, youtube,
  // Additional optional metadata
  seoDescription, featured, geoCoverage, neighborhoods, seasonality, accessibilityNotes, parking, kidFriendly, petFriendly, bestFor, sources, pageItems, hideSignup, ogImage} = content;

title = title ? title : "";

function parseTimeComponent(timeStr: string): string | null {
  const match = timeStr.trim().match(/^(\d+)(?::(\d+))?\s*(am|pm)$/i);
  if (!match) return null;
  let hours = parseInt(match[1]);
  const minutes = match[2] ? parseInt(match[2]) : 0;
  const ampm = match[3].toLowerCase();
  if (ampm === 'pm' && hours !== 12) hours += 12;
  if (ampm === 'am' && hours === 12) hours = 0;
  return `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:00`;
}

function buildStartDate(date: string, timeField: string | undefined): string {
  if (!timeField || timeField.toLowerCase() === 'varies') return date;
  const parts = timeField.split(/\s*(?:to|-)\s*/i);
  const t = parseTimeComponent(parts[0]);
  return t ? `${date}T${t}` : date;
}

function buildEndDate(date: string, timeField: string | undefined): string {
  if (!timeField || timeField.toLowerCase() === 'varies') return date;
  const parts = timeField.split(/\s*(?:to|-)\s*/i);
  if (parts.length < 2) return date;
  const t = parseTimeComponent(parts[parts.length - 1]);
  return t ? `${date}T${t}` : date;
}

function parsePostalAddress(addr: string | undefined) {
  if (!addr) return { streetAddress: '', addressLocality: 'Chattanooga', addressRegion: 'TN', postalCode: '', addressCountry: 'US' };
  const parts = addr.split(',').map((s: string) => s.trim());
  if (parts.length >= 3) {
    const stateZip = parts[2].trim().split(/\s+/);
    return {
      streetAddress: parts[0],
      addressLocality: parts[1],
      addressRegion: stateZip[0] || 'TN',
      postalCode: stateZip[1] || '',
      addressCountry: 'US',
    };
  }
  return { streetAddress: addr, addressLocality: 'Chattanooga', addressRegion: 'TN', postalCode: '', addressCountry: 'US' };
}

const eventImage = ogImage
  ? `https://thingshappening.com${ogImage}`
  : 'https://thingshappening.com/images/social.png';

const baseUrl = 'https://thingshappening.com';
const pathParts = Astro.url.pathname.replace(/\/$/, '').split('/').filter(Boolean);
const sectionLabels: Record<string, string> = { guides: 'Guides', events: 'Events', editorials: 'Editorials' };
const breadcrumbItems = pathParts.length >= 2
  ? [
      { position: 1, name: 'Home', item: baseUrl },
      { position: 2, name: 'Chattanooga', item: `${baseUrl}/${pathParts[0]}` },
      { position: 3, name: sectionLabels[pathParts[1]] || pathParts[1], item: `${baseUrl}/${pathParts[0]}/${pathParts[1]}` },
      { position: 4, name: title, item: `${baseUrl}${Astro.url.pathname}` },
    ]
  : [];
---
<html lang={ content.lang || 'en' }>
  <head>
    <BaseHead title={title} description={seoDescription || description} ogImage={ogImage ? `https://thingshappening.com${ogImage}` : undefined} />
    <script is:inline>
      if (window.location.search.includes('tags=') || window.location.search.includes('date=')) {
        var meta = document.createElement('meta');
        meta.name = 'robots';
        meta.content = 'noindex, follow';
        document.head.appendChild(meta);
      }
    </script>
    {pubDate && venue && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Event",
        "name": title,
        "description": seoDescription || description || "",
        "startDate": buildStartDate(pubDate, time),
        "endDate": buildEndDate(pubDate, time),
        "eventStatus": "https://schema.org/EventScheduled",
        "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
        "image": eventImage,
        "organizer": {
          "@type": "Organization",
          "name": "Things Happening",
          "url": "https://thingshappening.com"
        },
        "location": {
          "@type": "Place",
          "name": venue,
          "address": {
            "@type": "PostalAddress",
            ...parsePostalAddress(address)
          }
        },
        "url": `https://thingshappening.com${Astro.url.pathname}`,
        ...(eventLink ? {
          "offers": {
            "@type": "Offer",
            "url": eventLink,
            ...(entranceCost && entranceCost.toLowerCase() === "free"
              ? { "price": "0", "priceCurrency": "USD" }
              : {}
            )
          }
        } : {})
      })} />
    )}
    {breadcrumbItems.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": breadcrumbItems.map(({ position, name, item }) => ({
          "@type": "ListItem",
          position,
          name,
          item,
        })),
      })} />
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600&family=Raleway:wght@300;400;600&family=Libre+Baskerville:wght@400;700&display=swap" rel="stylesheet" />
  </head>

  <body>
    <Nav />
    <main class="overflow-hidden">
      <BlogPost tags={tags} author={author} readTime={readTime} matchedDetails={matchedDetails} originalDate={originalDate} lastUpdated={lastUpdated} eventDatesDetails={eventDatesDetails} eventDates={eventDates} address={address} eventLink={eventLink} entranceCost={entranceCost} ticketsLink={ticketsLink} title={title} venue={venue} venueDetails={venueDetails} time={time} hero={hero} pubDate={pubDate} youtube={youtube}
        seoDescription={seoDescription} featured={featured} geoCoverage={geoCoverage} neighborhoods={neighborhoods} seasonality={seasonality} accessibilityNotes={accessibilityNotes} parking={parking} kidFriendly={kidFriendly} petFriendly={petFriendly} bestFor={bestFor} sources={sources} pageItems={pageItems}
        seriesLabel={content.seriesLabel} pathname={Astro.url.pathname} hideSignup={hideSignup}
      >
        <slot pageItems={pageItems} />
      </BlogPost>
    </main>
    <Footer />
  </body>
</html>

