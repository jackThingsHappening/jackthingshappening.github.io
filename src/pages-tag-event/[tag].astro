---
import Card from '../../../components/Card.astro';
import HomeHeader from '../../../components/HomeHeader.astro';
import Nav from '../../../components/Nav.astro';
import SubNav from '../../../components/SubNav.astro';
import BaseHead from '../../../components/Head/BaseHead.astro';
import Footer from '../../../components/Footer/Footer.astro';

export async function getStaticPaths() {
  const allPosts = (Object.values(import.meta.glob('../../**/**/*.mdx', { eager: true }))).filter(
    (post) => post.frontmatter.published !== false
  );

  let tags = new Set(
    allPosts.flatMap(post =>
      post.frontmatter.tags
        ? post.frontmatter.tags
            .filter(t => t.type === "event")
            .map(t => t.tag)
        : []
    )
  );

  tags = Array.from(tags).filter(Boolean);

  return tags.map(tag => ({
    params: { tag }
  }));
}


const { tag } = Astro.params;

// Get only events that have a tag matching the current tag param
const filteredEvents = (Object.values(import.meta.glob('../../**/**/*.mdx', { eager: true }))).filter(post =>
  post.frontmatter.published !== false && post.frontmatter.tags?.some(t => t.type === "event" && t.tag === tag)
);


// Flatten event posts with multiple dates
const allPostsIncludingMultipleDates = [];
filteredEvents.forEach((p) => {
  const base = { ...p.frontmatter, url: p.url };
  if (base.eventDates) {
    base.eventDates.forEach((date) => {
      allPostsIncludingMultipleDates.push({
        ...base,
        pubDate: date,
        url: `${base.url}?date=${date}`
      });
    });
  } else {
    allPostsIncludingMultipleDates.push(base);
  }
});

