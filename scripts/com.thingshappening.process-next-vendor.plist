<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.thingshappening.process-next-vendor</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/elixir</string>
    <string>/Users/jack.burum/portfolio-of-small-bets/things_happening/scripts/process-next-vendor.exs</string>
  </array>

  <!-- Runs daily at 9:00am. Change Hour to adjust. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>WorkingDirectory</key>
  <string>/Users/jack.burum/portfolio-of-small-bets/things_happening</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/jack.burum</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/jack.burum/portfolio-of-small-bets/things_happening/logs/process-next-vendor.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/jack.burum/portfolio-of-small-bets/things_happening/logs/process-next-vendor.error.log</string>
</dict>
</plist>
